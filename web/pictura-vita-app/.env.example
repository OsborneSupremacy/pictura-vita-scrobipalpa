# Where the browser sends API calls.
#
# The default is "/api", which the Vite dev server proxies to the local API (see
# vite.config.ts). Leaving it alone means the browser never makes a cross-origin request
# and the API needs no CORS policy.
#
# VITE_API_BASE_URL=/api

# Origin of the locally-running API that the dev-server proxy forwards to.
# This app is local-only by design; do not point it at a hosted API.
# API_ORIGIN=http://localhost:5199
