# Source spreadsheet to import from.
SOURCE_EXCEL_FILE_PATH='/path/to/data.xlsx'

# Destination JSON timeline store the importer writes.
# Re-running the importer REPLACES the timeline it previously wrote for this workbook
# rather than appending another copy.
DATA_FILE_PATH='/path/to/timeline-data.json'

# Values already set in your shell take precedence over this file, so you can safely
# redirect a test run:
#   DATA_FILE_PATH=/tmp/scratch.json dotnet run --project src/Pictura.Vita.Excel.Importer
#
# Rows that fail validation stop the import with a report. Pass --skip-invalid to import
# everything else and skip the bad rows.
