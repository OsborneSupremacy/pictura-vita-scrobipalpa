# ============================================================================
# The spreadsheet is NO LONGER the source of truth (2026-08-30).
#
# The timeline folder is now the master copy and is edited in the app. This importer is a
# one-off migration tool that has already done its job. See docs/data-store.md.
#
# Running it against your real timelines is DESTRUCTIVE. The timeline id is derived from the
# workbook's path, and the id names the folder, so a re-import always lands on the folder
# already there and replaces its data.v1.json — writing back the importer's defaults for
# everything the workbook has no column for: every image name, every narrative name, every
# category icon and colour, every confidentiality level, and every edit made in the app since.
# (The images/ and narratives/ folders themselves are untouched; their files simply stop being
# referenced by anything.)
#
# If you ever need it again, point TIMELINES_ROOT_PATH at a scratch directory first.
# ============================================================================

# Source spreadsheet to import from.
SOURCE_EXCEL_FILE_PATH='/path/to/data.xlsx'

# The timelines directory the importer writes into. It creates (or replaces) one folder in
# there, named for the timeline id derived from the workbook's path — see the warning at the
# top of this file.
TIMELINES_ROOT_PATH='/path/to/timelines'

# Values already set in your shell take precedence over this file, so you can safely
# redirect a test run:
#   TIMELINES_ROOT_PATH=/tmp/scratch dotnet run --project src/Pictura.Vita.Excel.Importer
#
# Rows that fail validation stop the import with a report. Pass --skip-invalid to import
# everything else and skip the bad rows.
