# One-shot migration from the old single-file store to one folder per timeline.
# Copy to `.env` in this project and set both paths.

# The old shared data file: the one that held every timeline in a single "timeline" array,
# with images/<timeline id>/ and narratives/<timeline id>/ beside it.
#
# This file and everything around it is only ever read. Nothing under its directory is moved,
# rewritten or deleted — a complete personal timeline is identity-grade data, and until the new
# tree has been opened and looked at, the old one is the only copy.
#
# An export bundle downloaded from the app works here too: it is the same shape.
DATA_FILE_PATH='/path/to/timeline-data.json'

# Where the timeline folders are written. Use a scratch directory first, look at the result,
# and only then point the API at it.
#
# The tool refuses to write into a folder that already holds a data.v1.json, so a second run
# stops rather than overwriting what the first one produced.
TIMELINES_ROOT_PATH='/tmp/pictura-vita-migrated'

# Run it:
#   dotnet run --project src/Pictura.Vita.Migration            # dry run; reports what it would do
#   dotnet run --project src/Pictura.Vita.Migration -- --commit
