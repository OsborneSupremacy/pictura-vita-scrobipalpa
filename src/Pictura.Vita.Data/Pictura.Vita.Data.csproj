<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoBogus" Version="2.13.1" />
        <PackageReference Include="Bogus" Version="35.6.5" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Pictura.Vita.Domain.Extensions\Pictura.Vita.Domain.Extensions.csproj" />
      <ProjectReference Include="..\Pictura.Vita.Domain\Pictura.Vita.Domain.csproj" />
      <ProjectReference Include="..\Pictura.Vita.Messaging\Pictura.Vita.Messaging.csproj" />
      <ProjectReference Include="..\Pictura.Vita.Utility\Pictura.Vita.Utility.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- The fabricated sample timeline, copied as the directory tree the API expects:
           test/timelines/<id>/data.v1.json. Refreshed on every build, so running against it
           never dirties the checked-in copy. -->
      <None Remove="test\**" />
      <Content Include="test\**">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
